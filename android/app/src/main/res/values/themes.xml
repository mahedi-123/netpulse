<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- NoActionBar: the web UI supplies its own header, so a native title bar
         would just duplicate it. Colors match the app's chassis palette so the
         status bar and splash don't flash white on launch. -->
    <style name="Theme.NetPulse" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">#0F0D0A</item>
        <item name="android:navigationBarColor">#0F0D0A</item>
        <item name="android:windowBackground">#0F0D0A</item>
    </style>
</resources>
